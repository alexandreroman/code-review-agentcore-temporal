# Région de toutes les ressources AWS
AWS_REGION=ca-central-1

# Temporal Cloud (namespace existant, authentification mTLS)
TEMPORAL_NAMESPACE=your-namespace.a1b2c
TEMPORAL_ADDRESS=your-namespace.a1b2c.tmprl.cloud:7233
TEMPORAL_TLS_CERT_PATH=certs/client.pem
TEMPORAL_TLS_KEY_PATH=certs/client.key
# Surcharges optionnelles (par défaut : les valeurs de TEMPORAL_TLS_*)
# TEMPORAL_WORKER_CERT_PATH=certs/worker.pem
# TEMPORAL_WORKER_KEY_PATH=certs/worker.key
# TEMPORAL_ROUTER_CERT_PATH=certs/router.pem
# TEMPORAL_ROUTER_KEY_PATH=certs/router.key
TEMPORAL_DEPLOYMENT_NAME=agentic-review
TASK_QUEUE=review
DEV_TASK_QUEUE=review-dev
DEV_BRANCH_PREFIX=dev/

# LLM (API Anthropic directe)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
MAX_PARALLEL_AGENTS=3

# GitHub
GITHUB_OWNER=
DEMO_REPO=temporal-agentic-review-demo
GITHUB_APP_NAME=temporal-agentic-review

# AgentCore
AGENTCORE_IDLE_TIMEOUT=120

# Ports locaux (réécrits par make worktree-init à partir de CASPER_PORT)
GITHUB_APP_CALLBACK_PORT=8765
WORKER_METRICS_PORT=8766
