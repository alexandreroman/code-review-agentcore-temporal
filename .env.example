# Plain KEY=value lines, no quotes: the Makefile includes this file.
# Commented-out settings show their default value.

# Region of every AWS resource
AWS_REGION=ca-central-1

# Temporal Cloud namespace (required) and its mTLS client certificate
TEMPORAL_NAMESPACE=your-namespace.a1b2c
# TEMPORAL_ADDRESS=<TEMPORAL_NAMESPACE>.tmprl.cloud:7233
TEMPORAL_TLS_CERT_PATH=certs/client.pem
TEMPORAL_TLS_KEY_PATH=certs/client.key
# Optional overrides (default: the TEMPORAL_TLS_* values)
# TEMPORAL_WORKER_CERT_PATH=certs/worker.pem
# TEMPORAL_WORKER_KEY_PATH=certs/worker.key
# TEMPORAL_ROUTER_CERT_PATH=certs/router.pem
# TEMPORAL_ROUTER_KEY_PATH=certs/router.key
TEMPORAL_DEPLOYMENT_NAME=agentcore-review-demo-worker
TASK_QUEUE=review
DEV_TASK_QUEUE=review-dev
DEV_BRANCH_PREFIX=dev/

# LLM (direct Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
MAX_PARALLEL_AGENTS=3

# GitHub demo repository (default owner: the account logged in to gh)
# GITHUB_OWNER=your-github-login
DEMO_REPO=agentcore-review-demo-app
GITHUB_APP_NAME=temporal-agentcore-review-demo

# AgentCore
AGENTCORE_IDLE_TIMEOUT=120

# Local port: GitHub App manifest callback
GITHUB_APP_CALLBACK_PORT=8765
